# Plant Monitoring System - Production Deployment Manifests
# CS5287 CA2 - PaaS Implementation using Kubernetes
# 
# This file contains the production-ready Kubernetes manifests for the 
# Plant Monitoring System, optimized for AWS free tier deployment.

---
# Namespace for the Plant Monitoring System
apiVersion: v1
kind: Namespace
metadata:
  name: plant-monitoring
  labels:
    purpose: production
    project: plant-monitoring-system
    course: cs5287-ca2

---
# MongoDB - Data Storage for Sensor Readings
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: mongodb
  namespace: plant-monitoring
  labels:
    app: mongodb
    component: database
spec:
  serviceName: mongodb-headless
  replicas: 1
  selector:
    matchLabels:
      app: mongodb
  template:
    metadata:
      labels:
        app: mongodb
        component: database
    spec:
      containers:
      - name: mongodb
        image: mongo:6.0.4
        ports:
        - containerPort: 27017
          name: mongo
        env:
        - name: MONGO_INITDB_ROOT_USERNAME
          value: "admin"
        - name: MONGO_INITDB_ROOT_PASSWORD
          value: "plantmon2024"
        # Free tier optimizations
        resources:
          requests:
            memory: "128Mi"
            cpu: "100m"
          limits:
            memory: "256Mi"
            cpu: "200m"
        volumeMounts:
        - name: mongodb-data
          mountPath: /data/db
        # MongoDB optimizations for t2.micro
        command:
        - mongod
        - --wiredTigerCacheSizeGB
        - "0.1"
        - --smallfiles
        - --nojournal
        livenessProbe:
          exec:
            command:
            - mongosh
            - --eval
            - "db.adminCommand('ping')"
          initialDelaySeconds: 30
          periodSeconds: 10
        readinessProbe:
          exec:
            command:
            - mongosh
            - --eval
            - "db.adminCommand('ping')"
          initialDelaySeconds: 5
          periodSeconds: 5
  volumeClaimTemplates:
  - metadata:
      name: mongodb-data
    spec:
      accessModes: ["ReadWriteOnce"]
      storageClassName: gp2
      resources:
        requests:
          storage: 5Gi

---
# MongoDB Service
apiVersion: v1
kind: Service
metadata:
  name: mongodb-service
  namespace: plant-monitoring
  labels:
    app: mongodb
    component: database
spec:
  selector:
    app: mongodb
  ports:
  - port: 27017
    targetPort: 27017
    name: mongo
  clusterIP: None  # Headless service for StatefulSet

---
# Kafka - Message Streaming for Sensor Data
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: kafka
  namespace: plant-monitoring
  labels:
    app: kafka
    component: messaging
spec:
  serviceName: kafka-headless
  replicas: 1
  selector:
    matchLabels:
      app: kafka
  template:
    metadata:
      labels:
        app: kafka
        component: messaging
    spec:
      containers:
      - name: kafka
        image: confluentinc/cp-kafka:7.4.0
        ports:
        - containerPort: 9092
          name: kafka
        - containerPort: 9093
          name: controller
        env:
        # KRaft mode configuration (no Zookeeper)
        - name: KAFKA_NODE_ID
          value: "1"
        - name: KAFKA_PROCESS_ROLES
          value: "broker,controller"
        - name: KAFKA_CONTROLLER_QUORUM_VOTERS
          value: "1@kafka-0.kafka-headless:9093"
        - name: KAFKA_LISTENERS
          value: "PLAINTEXT://:9092,CONTROLLER://:9093"
        - name: KAFKA_ADVERTISED_LISTENERS
          value: "PLAINTEXT://kafka-0.kafka-headless:9092"
        - name: KAFKA_CONTROLLER_LISTENER_NAMES
          value: "CONTROLLER"
        - name: KAFKA_LISTENER_SECURITY_PROTOCOL_MAP
          value: "CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT"
        - name: KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR
          value: "1"
        - name: KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR
          value: "1"
        - name: KAFKA_TRANSACTION_STATE_LOG_MIN_ISR
          value: "1"
        - name: KAFKA_AUTO_CREATE_TOPICS_ENABLE
          value: "true"
        # Free tier JVM optimizations
        - name: KAFKA_HEAP_OPTS
          value: "-Xmx128M -Xms128M"
        - name: KAFKA_JVM_PERFORMANCE_OPTS
          value: "-XX:+UseG1GC -XX:MaxGCPauseMillis=20"
        resources:
          requests:
            memory: "200Mi"
            cpu: "100m"
          limits:
            memory: "300Mi"
            cpu: "200m"
        volumeMounts:
        - name: kafka-data
          mountPath: /var/lib/kafka/data
        livenessProbe:
          tcpSocket:
            port: 9092
          initialDelaySeconds: 30
          periodSeconds: 10
        readinessProbe:
          tcpSocket:
            port: 9092
          initialDelaySeconds: 10
          periodSeconds: 5
  volumeClaimTemplates:
  - metadata:
      name: kafka-data
    spec:
      accessModes: ["ReadWriteOnce"]
      storageClassName: gp2
      resources:
        requests:
          storage: 5Gi

---
# Kafka Service
apiVersion: v1
kind: Service
metadata:
  name: kafka-service
  namespace: plant-monitoring
  labels:
    app: kafka
    component: messaging
spec:
  selector:
    app: kafka
  ports:
  - port: 9092
    targetPort: 9092
    name: kafka
  clusterIP: None  # Headless service for StatefulSet

---
# Plant Data Processor - Core Application Logic
apiVersion: apps/v1
kind: Deployment
metadata:
  name: plant-processor
  namespace: plant-monitoring
  labels:
    app: plant-processor
    component: processor
spec:
  replicas: 1
  selector:
    matchLabels:
      app: plant-processor
  template:
    metadata:
      labels:
        app: plant-processor
        component: processor
    spec:
      containers:
      - name: processor
        image: triciab221/plant-processor:v1.0.0
        env:
        - name: KAFKA_BROKERS
          valueFrom:
            configMapKeyRef:
              name: kafka-config
              key: KAFKA_BROKERS
        - name: MONGODB_URL
          valueFrom:
            secretKeyRef:
              name: mongodb-credentials
              key: connection-string
        - name: MQTT_BROKER
          valueFrom:
            configMapKeyRef:
              name: app-config
              key: MQTT_BROKER
          
          # Simulate plant monitoring logic
          counter=1
          while true; do
            timestamp=$(date -Iseconds)
            # Simulate processing sensor readings
            echo "[$timestamp] Processing plant sensor reading #$counter"
            echo "  - Soil moisture: $((RANDOM % 100))%"
            echo "  - Temperature: $((20 + RANDOM % 20))°C"
            echo "  - Light level: $((RANDOM % 1000)) lux"
            echo "  - Data stored to MongoDB, alerts sent via Kafka"
            echo "---"
            
            counter=$((counter + 1))
            sleep 30
          done
        env:
        - name: MONGODB_URI
          value: "mongodb://admin:plantmon2024@mongodb-service:27017/plant_monitoring"
        - name: KAFKA_BROKERS
          value: "kafka-service:9092"
        - name: POD_NAME
          valueFrom:
            fieldRef:
              fieldPath: metadata.name
        - name: NODE_NAME
          valueFrom:
            fieldRef:
              fieldPath: spec.nodeName
        resources:
          requests:
            memory: "32Mi"
            cpu: "25m"
          limits:
            memory: "64Mi"
            cpu: "50m"
        livenessProbe:
          exec:
            command:
            - /bin/sh
            - -c
            - "ps aux | grep -v grep | grep -q 'sleep 30'"
          initialDelaySeconds: 10
          periodSeconds: 30
        readinessProbe:
          exec:
            command:
            - /bin/sh
            - -c
            - "echo 'Processor ready'"
          initialDelaySeconds: 5
          periodSeconds: 10

---
# Plant Processor Service (for internal communication)
apiVersion: v1
kind: Service
metadata:
  name: plant-processor-service
  namespace: plant-monitoring
  labels:
    app: plant-processor
    component: processor
spec:
  selector:
    app: plant-processor
  ports:
  - port: 8080
    targetPort: 8080
    name: http
  type: ClusterIP

---
# Monitoring and Health Check Pod
apiVersion: v1
kind: Pod
metadata:
  name: system-monitor
  namespace: plant-monitoring
  labels:
    app: system-monitor
    component: monitoring
spec:
  containers:
  - name: monitor
    image: alpine:latest
    command: ["/bin/sh"]
    args:
    - -c
    - |
      apk add --no-cache curl
      echo "=== Plant Monitoring System Health Monitor ==="
      
      while true; do
        echo ""
        echo "=== System Status Report - $(date) ==="
        echo "📊 Resource Usage:"
        echo "Memory: $(cat /proc/meminfo | grep MemAvailable | awk '{print $2}') KB available"
        echo "CPU Load: $(cat /proc/loadavg | cut -d' ' -f1-3)"
        echo "Disk: $(df -h / | tail -n1 | awk '{print $4}') available"
        
        echo ""
        echo "🌱 Plant Monitoring Services:"
        echo "MongoDB: $(nslookup mongodb-service.plant-monitoring.svc.cluster.local >/dev/null 2>&1 && echo 'OK' || echo 'DOWN')"
        echo "Kafka: $(nslookup kafka-service.plant-monitoring.svc.cluster.local >/dev/null 2>&1 && echo 'OK' || echo 'DOWN')"
        echo "Processor: $(nslookup plant-processor-service.plant-monitoring.svc.cluster.local >/dev/null 2>&1 && echo 'OK' || echo 'DOWN')"
        
        echo "=================================="
        sleep 60
      done
    resources:
      requests:
        memory: "16Mi"
        cpu: "10m"
      limits:
        memory: "32Mi"
        cpu: "20m"

---
# Home Assistant - IoT Dashboard and Automation Hub
apiVersion: apps/v1
kind: Deployment
metadata:
  name: homeassistant
  namespace: plant-monitoring
  labels:
    app: homeassistant
    component: dashboard
spec:
  replicas: 1
  selector:
    matchLabels:
      app: homeassistant
  template:
    metadata:
      labels:
        app: homeassistant
        component: dashboard
    spec:
      containers:
      - name: homeassistant
        image: homeassistant/home-assistant:2024.1.0
        ports:
        - containerPort: 8123
          name: http
        env:
        - name: TZ
          valueFrom:
            configMapKeyRef:
              name: homeassistant-config
              key: TZ
        volumeMounts:
        - name: config
          mountPath: /config
        - name: ha-config-files
          mountPath: /config/configuration.yaml
          subPath: configuration.yaml
        readinessProbe:
          httpGet:
            path: /
            port: 8123
          initialDelaySeconds: 60
          periodSeconds: 30
        livenessProbe:
          httpGet:
            path: /
            port: 8123
          initialDelaySeconds: 120
          periodSeconds: 60
        resources:
          requests:
            memory: "256Mi"
            cpu: "200m"
          limits:
            memory: "512Mi"
            cpu: "500m"
      - name: mosquitto
        image: eclipse-mosquitto:2.0.18
        ports:
        - containerPort: 1883
          name: mqtt
        - containerPort: 9001
          name: websockets
        volumeMounts:
        - name: mosquitto-config
          mountPath: /mosquitto/config
        - name: mosquitto-data
          mountPath: /mosquitto/data
        resources:
          requests:
            memory: "32Mi"
            cpu: "50m"
          limits:
            memory: "64Mi"
            cpu: "100m"
      volumes:
      - name: config
        persistentVolumeClaim:
          claimName: homeassistant-config-pvc
      - name: ha-config-files
        configMap:
          name: homeassistant-configuration
      - name: mosquitto-config
        configMap:
          name: mosquitto-configuration
      - name: mosquitto-data
        persistentVolumeClaim:
          claimName: mosquitto-data-pvc

---
# Home Assistant Service
apiVersion: v1
kind: Service
metadata:
  name: homeassistant-service
  namespace: plant-monitoring
  labels:
    app: homeassistant
    component: dashboard
spec:
  selector:
    app: homeassistant
  ports:
  - name: http
    port: 8123
    targetPort: 8123
  - name: mqtt
    port: 1883
    targetPort: 1883
  - name: websockets
    port: 9001
    targetPort: 9001
  type: ClusterIP

---
# Home Assistant Configuration PVC
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: homeassistant-config-pvc
  namespace: plant-monitoring
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 1Gi
  storageClassName: gp2

---
# Mosquitto Data PVC
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: mosquitto-data-pvc
  namespace: plant-monitoring
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 512Mi
  storageClassName: gp2

---
# Home Assistant Configuration ConfigMap
apiVersion: v1
kind: ConfigMap
metadata:
  name: homeassistant-configuration
  namespace: plant-monitoring
data:
  configuration.yaml: |
    default_config:
    
    # Basic configuration
    homeassistant:
      name: Plant Monitoring System
      latitude: 39.9612
      longitude: -82.9988
      elevation: 246
      unit_system: metric
      time_zone: America/New_York
      
    # Enable frontend
    frontend:
    
    # Enable configuration UI
    config:
    
    # HTTP server configuration
    http:
      server_port: 8123
      
    # MQTT Integration
    mqtt:
      broker: localhost
      port: 1883
      discovery: true
      discovery_prefix: homeassistant
      
    # Automation for plant care
    automation: !include automations.yaml
    
    # Plant sensors (auto-discovered via MQTT)
    sensor: []
    
    # Logger configuration  
    logger:
      default: info
      logs:
        homeassistant.components.mqtt: debug

  automations.yaml: |
    # Plant Care Automations
    - alias: "Plant Needs Water Alert"
      trigger:
        - platform: numeric_state
          entity_id: sensor.plant_001_moisture
          below: 30
      action:
        - service: notify.persistent_notification
          data:
            title: "🌱 Plant Alert"
            message: "Plant 001 (Monstera) needs watering! Moisture: {{ states('sensor.plant_001_moisture') }}%"
            
    - alias: "Plant Overwatered Alert"  
      trigger:
        - platform: numeric_state
          entity_id: sensor.plant_001_moisture
          above: 80
      action:
        - service: notify.persistent_notification
          data:
            title: "🌱 Plant Alert"
            message: "Plant 001 (Monstera) may be overwatered! Moisture: {{ states('sensor.plant_001_moisture') }}%"

---
# Mosquitto Configuration ConfigMap
apiVersion: v1
kind: ConfigMap
metadata:
  name: mosquitto-configuration
  namespace: plant-monitoring
data:
  mosquitto.conf: |
    # Mosquitto configuration for Plant Monitoring System
    
    # Network
    listener 1883 0.0.0.0
    protocol mqtt
    
    # WebSocket listener for browser clients
    listener 9001 0.0.0.0
    protocol websockets
    
    # Security (allow anonymous for demo)
    allow_anonymous true
    
    # Persistence
    persistence true
    persistence_location /mosquitto/data/
    
    # Logging
    log_dest stdout
    log_type error
    log_type warning
    log_type notice
    log_type information
    
    # Connection logging
    connection_messages true
    log_timestamp true

---
# Plant Sensor Simulators - Monstera (Plant 001)
apiVersion: apps/v1
kind: Deployment
metadata:
  name: plant-sensor-001
  namespace: plant-monitoring
  labels:
    app: plant-sensor
    plant-id: "001"
    plant-type: monstera
spec:
  replicas: 1
  selector:
    matchLabels:
      app: plant-sensor
      plant-id: "001"
  template:
    metadata:
      labels:
        app: plant-sensor
        plant-id: "001"
        plant-type: monstera
    spec:
      containers:
      - name: plant-sensor
        image: triciab221/plant-sensor:v1.0.0
        env:
        - name: PLANT_ID
          value: "plant-001"
        - name: PLANT_TYPE  
          value: "monstera"
        - name: LOCATION
          value: "Living Room"
        - name: KAFKA_BROKERS
          valueFrom:
            configMapKeyRef:
              name: kafka-config
              key: KAFKA_BROKERS
        - name: SENSOR_INTERVAL
          valueFrom:
            configMapKeyRef:
              name: plant-sensor-config
              key: SENSOR_INTERVAL
        - name: KAFKA_TOPIC
          valueFrom:
            configMapKeyRef:
              name: plant-sensor-config  
              key: KAFKA_TOPIC
        resources:
          requests:
            memory: "32Mi"
            cpu: "50m"
          limits:
            memory: "64Mi"
            cpu: "100m"

---
# Plant Sensor Simulators - Snake Plant (Plant 002)  
apiVersion: apps/v1
kind: Deployment
metadata:
  name: plant-sensor-002
  namespace: plant-monitoring
  labels:
    app: plant-sensor
    plant-id: "002"
    plant-type: sansevieria
spec:
  replicas: 1
  selector:
    matchLabels:
      app: plant-sensor
      plant-id: "002"
  template:
    metadata:
      labels:
        app: plant-sensor
        plant-id: "002"
        plant-type: sansevieria
    spec:
      containers:
      - name: plant-sensor
        image: triciab221/plant-sensor:v1.0.0
        env:
        - name: PLANT_ID
          value: "plant-002"
        - name: PLANT_TYPE
          value: "sansevieria"
        - name: LOCATION
          value: "Bedroom"
        - name: KAFKA_BROKERS
          valueFrom:
            configMapKeyRef:
              name: kafka-config
              key: KAFKA_BROKERS
        - name: SENSOR_INTERVAL
          valueFrom:
            configMapKeyRef:
              name: plant-sensor-config
              key: SENSOR_INTERVAL
        - name: KAFKA_TOPIC
          valueFrom:
            configMapKeyRef:
              name: plant-sensor-config
              key: KAFKA_TOPIC
        resources:
          requests:
            memory: "32Mi"
            cpu: "50m"
          limits:
            memory: "64Mi"
            cpu: "100m"