# WireGuard VPN Configuration Template - Cloud Gateway (AWS Manager Node)
# CA4: Edge-to-Cloud Plant Monitoring System
# 
# This file is a TEMPLATE. Run setup-vpn.sh to generate actual config.
# Deploy to: /etc/wireguard/wg0.conf on AWS manager node

[Interface]
# Cloud VPN Gateway Address
Address = 10.20.0.1/24

# Cloud Private Key (generated by generate-keys.sh)
PrivateKey = {{CLOUD_PRIVATE_KEY}}

# WireGuard listening port (UDP)
ListenPort = 51820

# Post-up: Enable IP forwarding and NAT for VPN traffic
# This allows edge sensors to reach Docker overlay networks
PostUp = sysctl -w net.ipv4.ip_forward=1
PostUp = iptables -A FORWARD -i wg0 -j ACCEPT
PostUp = iptables -A FORWARD -o wg0 -j ACCEPT
PostUp = iptables -t nat -A POSTROUTING -o eth0 -j MASQUERADE

# Post-down: Clean up firewall rules on VPN shutdown
PostDown = iptables -D FORWARD -i wg0 -j ACCEPT
PostDown = iptables -D FORWARD -o wg0 -j ACCEPT
PostDown = iptables -t nat -D POSTROUTING -o eth0 -j MASQUERADE

[Peer]
# Edge Site (Local Laptop/VM)
PublicKey = {{EDGE_PUBLIC_KEY}}

# Allow edge to use VPN IP 10.20.0.2
AllowedIPs = 10.20.0.2/32

# Keep connection alive through NAT
PersistentKeepalive = 25

# ============================================================================
# CA4 ARCHITECTURE NOTES
# ============================================================================
#
# VPN Network: 10.20.0.0/24
#   - Cloud Gateway: 10.20.0.1 (this node)
#   - Edge Client:   10.20.0.2
#
# Kafka Access:
#   - Edge sensors connect to: 10.20.0.1:9092
#   - Kafka EXTERNAL listener advertised on: 10.20.0.1:9092
#   - Security group restricts Kafka to VPN subnet (10.20.0.0/24)
#
# Routing:
#   - Edge sensors → wg0 (10.20.0.1) → Docker overlay (10.10.2.0/24) → Kafka
#   - PostUp rules enable NAT/forwarding
#
# Security:
#   - ChaCha20-Poly1305 encryption (WireGuard default)
#   - Only edge public key allowed (no unauthorized peers)
#   - AWS security group allows UDP 51820 from internet
#
# ============================================================================
