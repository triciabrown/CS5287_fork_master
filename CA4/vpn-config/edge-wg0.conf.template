# WireGuard VPN Configuration Template - Edge Client (Local Laptop/VM)
# CA4: Edge-to-Cloud Plant Monitoring System
#
# This file is a TEMPLATE. Run setup-vpn.sh to generate actual config.
# Deploy to: /etc/wireguard/wg0.conf on local edge machine

[Interface]
# Edge VPN Client Address
Address = 10.20.0.2/24

# Edge Private Key (generated by generate-keys.sh)
PrivateKey = {{EDGE_PRIVATE_KEY}}

# Optional: DNS servers accessible via VPN (if needed)
# DNS = 10.0.0.2

# Note: Routes are automatically added by AllowedIPs below
# No need for explicit PostUp/PostDown route commands

[Peer]
# Cloud VPN Gateway (AWS Manager Node)
PublicKey = {{CLOUD_PUBLIC_KEY}}

# Cloud public endpoint (AWS Manager IP)
Endpoint = {{AWS_MANAGER_IP}}:51820

# Allow traffic to:
#   - VPN gateway (10.20.0.1)
#   - Docker overlay networks (10.10.0.0/16)
AllowedIPs = 10.20.0.1/32, 10.10.0.0/16

# Keep connection alive through NAT
PersistentKeepalive = 25

# ============================================================================
# CA4 ARCHITECTURE NOTES
# ============================================================================
#
# VPN Network: 10.20.0.0/24
#   - Edge Client:   10.20.0.2 (this machine)
#   - Cloud Gateway: 10.20.0.1
#
# Kafka Access:
#   - Sensors use KAFKA_BROKERS=10.20.0.1:9092
#   - Traffic encrypted through VPN tunnel
#   - Reaches Kafka EXTERNAL listener in cloud
#
# Routing:
#   - 10.20.0.1/32 → VPN gateway
#   - 10.10.0.0/16 → Docker overlay networks (via gateway)
#   - Allows edge to reach messaging-net (10.10.2.0/24) for Kafka
#
# NAT Traversal:
#   - PersistentKeepalive ensures connection stays open
#   - Works through home/office NAT routers
#
# Security:
#   - ChaCha20-Poly1305 encryption
#   - Only cloud public key trusted
#   - Endpoint must match actual AWS Manager IP
#
# Verification:
#   - ping 10.20.0.1  # Test VPN gateway
#   - telnet 10.20.0.1 9092  # Test Kafka access
#
# ============================================================================
